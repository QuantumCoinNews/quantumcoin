# QuantumCoin socialbot example environment file
# Copy this file to .env and fill real values locally.
# Never commit real tokens, keys, secrets, or passwords.

# Timezone
TZ=Europe/Istanbul

# Daily schedule
# Note: node/go cron behavior may use process timezone depending on scheduler.
CRON_1=0 18 * * *
CRON_2=0 21 * * *

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Content folders
CONTENT_QUEUE_DIR=content/queue
CONTENT_MEDIA_DIR=content/media
