# QuantumCoin node environment examples. Export values into the process environment.
# Keep credentials in local custody. The node reads config.json and environment.
QC_API_BASE=http://127.0.0.1:8082
QC_HTTP_PORT=:8082
QC_P2P_PORT=:3001
QC_API_LISTEN=127.0.0.1:8082
QC_API_TOKEN=
# Optional direct loopback connection from the publisher to node monitoring.
QC_PUBLISHER_MONITOR_TOKEN=
QC_CORS_ALLOWED_ORIGINS=
QC_NETWORK=local-release
QC_NET_MAGIC=
QC_DEV_MODE=0
QC_MAINNET=0
QC_TESTNET=0
QC_PUBLIC_TESTNET=0
# Non-loopback bind requires a token. Use exact HTTPS origins in the CORS list.
# The explicit testnet and isolated local profiles use their own config and ports.
# Publisher credentials and settings live under autopublisher.
# TikTok is a manual publication channel.
