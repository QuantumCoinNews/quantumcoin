# QC_TG_TESTNET_CONNECTION_V1
# Telegram Game local/main mode
# Optional absolute existing SQLite path; never a cwd-relative path.
QC_GAME_DB=
# Optional absolute base directory for new local/testnet/mainnet data directories.
QC_GAME_DATA_DIR=
TELEGRAM_GAME_CHAIN_MODE=local
TELEGRAM_GAME_NETWORK=local
QC_API_BASE=http://127.0.0.1:8082
QUANTUMCOIN_API_BASE=http://127.0.0.1:8082
QC_NODE_API=http://127.0.0.1:8082

# Telegram Game testnet mode example
# TELEGRAM_GAME_CHAIN_MODE=testnet
# TELEGRAM_GAME_NETWORK=testnet
# QC_TESTNET=1
# QC_NETWORK=testnet
# QC_CHAIN_MODE=testnet
# QC_NET_MAGIC=QC_TESTNET_V1
# QC_API_BASE=http://127.0.0.1:18082
# QUANTUMCOIN_API_BASE=http://127.0.0.1:18082
# QC_NODE_API=http://127.0.0.1:18082
# TELEGRAM_GAME_MINING_MODE=TESTNET_SIMULATED

# TGWT_BSC_CLAIM_MAINNET_TESTNET_LOCK_V1
# Public config only. Do NOT put private keys, seed phrases, mnemonics, or hot-wallet secrets here.
# Default safe mode: claim disabled.
TGWT_BSC_CLAIM_ENABLED=0
TGWT_BSC_NETWORK=bsc_testnet
TGWT_BSC_CHAIN_ID=97
TGWT_BSC_DISTRIBUTION_WALLET_ADDRESS=
TGWT_BSC_TOKEN_CONTRACT_ADDRESS=
TGWT_BSC_CLAIM_CONTRACT_ADDRESS=

# QMA-0098 SOCIAL TGWT REWARDS — OFF BY DEFAULT; TESTNET NEVER REWARDS.
# Enabling requires BSC mainnet (chain 56), an approved/enabled user-paid claim,
# verified provider setup and an operator-controlled campaign signing key.
QC_TGWT_SOCIAL_REWARDS_ENABLED=0
QC_TGWT_REWARD_SIGNING_SEED_FILE=

# YouTube read-only OAuth; use only for the subscription-verification feature.
# Callback must exactly match the registered HTTPS URL.
QC_YOUTUBE_CLIENT_ID=
QC_YOUTUBE_CLIENT_SECRET=
QC_YOUTUBE_CALLBACK_URL=https://game.example/oauth/youtube/callback
QC_YOUTUBE_STATE_ENCRYPTION_KEY=

# X provider credentials and OAuth state key are configured separately.
# Do not paste provider credentials into chat, source files or campaign links.

# Mainnet claim must stay disabled until explicit manual approval.
# TGWT_BSC_NETWORK=bsc_mainnet
# TGWT_BSC_CHAIN_ID=56
# TGWT_BSC_MAINNET_CLAIM_APPROVAL=I_APPROVE_TGWT_BSC_MAINNET_CLAIM

# Forbidden in code/repo/client:
# TGWT_BSC_PRIVATE_KEY=
# TGWT_BSC_TREASURY_PRIVATE_KEY=
# TGWT_BSC_DISTRIBUTION_PRIVATE_KEY=
# TGWT_BSC_SEED=
# TGWT_BSC_MNEMONIC=

# WATCH_EARN_TESTNET_FINAL_LOCK_V1
# Default safe mode: DEV/TESTNET only. Final revenue mode is not active here.
WATCH_EARN_MODE=dev
WATCH_EARN_FINAL_ENABLED=0
WATCH_EARN_PROVIDER=none
WATCH_EARN_SERVER_SIDE_VERIFICATION_REQUIRED=0
WATCH_EARN_REWARD_ASSET=TGWT
WATCH_EARN_REWARD_LEDGER_STATE=pending

# Final/mainnet activation later requires explicit approval and verified rewarded ads.
# WATCH_EARN_MODE=final
# WATCH_EARN_FINAL_ENABLED=1
# WATCH_EARN_PROVIDER=google_rewarded_ads
# WATCH_EARN_SERVER_SIDE_VERIFICATION_REQUIRED=1
# WATCH_EARN_FINAL_APPROVAL=I_APPROVE_WATCH_EARN_FINAL_VERIFIED_AD_REWARDS

# QC_ADMIN_PANEL_AUTH_PAGINATION_V1
# Admin panel/API registry auth.
# Do not commit real production tokens here.
TELEGRAM_GAME_ADMIN_AUTH_REQUIRED=0
TELEGRAM_GAME_ADMIN_TOKEN=
QC_ADMIN_TOKEN=
# Admin requests may use:
# X-Admin-Token: <token>
# X-QC-ADMIN-TOKEN: <token>
# Authorization: Bearer <token>
