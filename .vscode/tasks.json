{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HATA TARAMA: build all",
      "type": "shell",
      "command": "go build ./...",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "HATA TARAMA: wallet gui",
      "type": "shell",
      "command": "go build ./cmd/wallet",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$go"]
    }
  ]
}
