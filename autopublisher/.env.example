# Credentials for the canonical publisher. Copy to .env and fill locally.
# Never paste keys into a chat or commit real secrets.
# Non-secret runtime settings are in publisher.settings.
OPENAI_API_KEY=
YOUTUBE_CLIENT_SECRET_PATH=
YOUTUBE_TOKEN_PATH=
TW_CONSUMER_KEY=
TW_CONSUMER_SECRET=
TW_ACCESS_TOKEN=
TW_ACCESS_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional loopback node monitoring. Use a dedicated matching token on the node.
QC_PUBLISHER_MONITOR_ORIGIN=
QC_PUBLISHER_MONITOR_TOKEN=
# X_APP_KEY/X_APP_SECRET/X_ACCESS_TOKEN/X_ACCESS_SECRET aliases are also accepted.
# Instagram/TikTok are unavailable in the canonical runtime. Adding credentials
# alone does not enable them or produce a simulated success receipt.
