# QuantumCoin autopublisher example environment file
# Copy this file to .env and fill real values locally.
# Never commit real tokens, keys, secrets, passwords, private keys, or OAuth files.

# General
TZ=Europe/Istanbul
DAILY_CRON=0 18 * * *
CONTENT_LANG=en
LOG_LEVEL=info
REPO_URL=https://github.com/QuantumCoinNews/quantumcoin

# Content paths
CONTENT_DIR=src/content
OUT_DIR=src/content/out
QUEUE_DIR=src/content/queue
PROMPT_DIR=src/content/prompts

# OpenAI / AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TTS
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Stable Diffusion / image generation
SD_BASE_URL=http://127.0.0.1:7860
SD_MODEL=sdxl

# YouTube OAuth
YOUTUBE_CLIENT_SECRET_PATH=
YOUTUBE_TOKEN_PATH=
YOUTUBE_PRIVACY=public

# X / Twitter API
TW_CONSUMER_KEY=
TW_CONSUMER_SECRET=
TW_ACCESS_TOKEN=
TW_ACCESS_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_PREVIEW=false

# Instagram Graph
IG_PAGE_ID=
IG_PAGE_ACCESS_TOKEN=

# TikTok
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_ACCESS_TOKEN=

# Platform toggles
ENABLE_TELEGRAM=1
ENABLE_X=1
ENABLE_YOUTUBE=0
ENABLE_INSTAGRAM=0
ENABLE_TIKTOK=0
