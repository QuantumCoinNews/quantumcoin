// ----------------------------------------------------------------------------
//                             PERSISTENT PREFS
// ----------------------------------------------------------------------------

type prefs struct {
	Lang        string `json:"lang"`
	Dark        bool   `json:"dark"`
	Address     string `json:"address"`
	LastTo      string `json:"last_to"`
	AutoStart   bool   `json:"auto_start"`
	AutoRefresh int    `json:"auto_refresh_sec"`
}

func exeDir() string    { exe, _ := os.Executable(); return filepath.Dir(exe) }
func prefsPath() string { return filepath.Join(exeDir(), "wallet_prefs.json") }
func addrFile() string  { return filepath.Join(exeDir(), "wallet_address.txt") }

func loadPrefs() prefs {
	p := prefs{Lang: "tr", Dark: true, AutoRefresh: 5}
	if b, err := os.ReadFile(prefsPath()); err == nil {
		_ = json.Unmarshal(b, &p)
	}
	return p
}
func savePrefs(p prefs)          { _ = os.WriteFile(prefsPath(), must(json.MarshalIndent(p, "", "  ")), 0o644) }
func must[T any](v T, _ error) T { return v }

