release/miner_address.txt
release/wallet_balance.cache.json
release/mined_balance.json
release/quantumcoin.exe~
release/*_out.log
release/miner_out.log
release/api_out.log

# Allow-list release scripts that should stay versioned.
!/release/run_miner.cmd
!/release/run_miner.ps1
!/release/stop_miner.ps1
!/release/_qc_miner_stream.ps1

