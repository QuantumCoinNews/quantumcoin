# ================= Release folder =================
# Do not commit runtime/build outputs from release.
release/*.exe
release/*.dll
release/*.pdb
release/*.db
release/*.db-shm
release/*.db-wal
release/*.dat
release/*.log
release/*.json
release/*.txt
